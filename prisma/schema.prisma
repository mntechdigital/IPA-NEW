datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String   @default("IPA Administrator")
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSetting {
  id                   String   @id @default("default")
  siteName             String   @default("IPA — Institute of Public Affairs")
  shortName            String   @default("IPA")
  tagline              String   @default("Building an Informed Society Through Research, Dialogue & Action")
  editorialLead        String   @db.Text
  mission              String   @db.Text
  vision               String   @db.Text
  heroImage            String?  @default("/images/hero_public_dialogue.jpg")
  heroVideoUrl         String?
  heroVideoActive      Boolean  @default(false)
  announcementText     String?  @db.Text
  announcementLinkText String?
  announcementHref     String?
  announcementActive   Boolean  @default(true)
  contactEmail         String?  @default("info@ipa.org.bd")
  contactPhone         String?
  contactAddress       String?
  facebookUrl          String?
  twitterUrl           String?
  linkedinUrl          String?
  youtubeUrl           String?
  updatedAt            DateTime @updatedAt
}

model AboutSetting {
  id                     String   @id @default("default")
  heroEyebrow            String   @default("INSTITUTIONAL PROFILE & GOVERNANCE")
  heroTitle              String   @default("About the Institute of Public Affairs")
  heroDescription        String   @db.Text @default("Strengthening public understanding, media integrity, and democratic participation through empirical research and inclusive civic dialogue.")
  
  mandateEyebrow         String   @default("FOUNDATIONAL MANDATE")
  mandateTitle           String   @default("An Independent Hub for Evidence and Public Deliberation")
  mandateParagraph1      String   @db.Text
  mandateParagraph2      String   @db.Text
  mandatePrinciplesTitle String   @default("Our Research Principles:")
  mandatePrinciples      String   @db.Text
  mandateImage           String   @default("/images/research_media_analysis.jpg")
  mandateImageLabel      String   @default("IPA Research Archive & Library")
  mandateImageCaption    String   @default("Scholars analyzing media monitoring datasets and municipal audit filings.")
  
  milestones             Json     // [{ year: string, title: string, desc: string }]
  collaborators          Json     // string[]
  
  updatedAt              DateTime @updatedAt
}

model FocusArea {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @db.Text
  metrics     String
  order       Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model ImpactIndicator {
  id         String   @id @default(cuid())
  value      String
  label      String
  descriptor String   @db.Text
  order      Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model CoreValue {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  order       Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model ResearchItem {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  category         String
  type             String
  date             String
  year             Int
  featured         Boolean  @default(false)
  coverImage       String
  pages            Int      @default(1)
  fileSize         String   @default("2.0 MB")
  doi              String?
  abstract         String   @db.Text
  authors          Json     // [{ name, role, affiliation, avatar }]
  keyFindings      Json     // string[]
  executiveSummary String?  @db.Text
  methodology      String?  @db.Text
  discussion       String?  @db.Text
  recommendations  Json?    // string[]
  downloadUrl      String?
  published        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ProgramItem {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  subtitle         String
  status           String   // 'Ongoing' | 'Upcoming' | 'Completed'
  category         String
  description      String   @db.Text
  coverImage       String
  overview         String   @db.Text
  objectives       Json     // string[]
  activities       Json     // string[]
  targetAudience   String
  expectedOutcomes Json     // string[]
  leadFellow       String
  order            Int      @default(0)
  published        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model CampaignItem {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  tagline         String
  status          String   // 'Active Campaign' | 'Archived' | 'Upcoming'
  coverImage      String
  introduction    String   @db.Text
  whyItMatters    String   @db.Text
  objectives      Json     // string[]
  coreActions     Json     // string[]
  partnerNetworks Json     // string[]
  resources       Json     // [{ title, type, size }]
  order           Int      @default(0)
  published       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model NewsItem {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  category      String   // 'News' | 'Events' | 'Press Releases' | 'Announcements'
  date          String
  coverImage    String
  summary       String   @db.Text
  location      String?
  readTime      String   @default("4 min read")
  content       Json     // string[] paragraphs
  relatedTopics Json     // string[]
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ResourceItem {
  id            String   @id @default(cuid())
  title         String
  type          String
  category      String
  date          String
  year          Int
  size          String
  description   String   @db.Text
  fileFormat    String   // 'PDF' | 'DOCX' | 'ZIP' | 'XLSX'
  downloadCount Int      @default(0)
  downloadUrl   String?
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model TeamMember {
  id                String   @id @default(cuid())
  name              String
  role              String
  division          String
  bio               String   @db.Text
  focusAreas        Json     // string[]
  publicationsCount Int      @default(0)
  avatar            String?
  order             Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ContactInquiry {
  id           String   @id @default(cuid())
  name         String
  email        String
  organization String?
  subject      String
  message      String   @db.Text
  status       String   @default("unread") // 'unread' | 'read' | 'archived'
  createdAt    DateTime @default(now())
}

model InvolvementSubmission {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  phone     String?
  role      String?
  interests String?
  message   String?  @db.Text
  status    String   @default("unread")
  createdAt DateTime @default(now())
}

model NewsletterSubscription {
  id        String   @id @default(cuid())
  email     String   @unique
  status    String   @default("active")
  createdAt DateTime @default(now())
}
